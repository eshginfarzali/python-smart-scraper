# Copy to .env and adjust. Every value below is the built-in default unless noted.
# All settings except DATABASE_URL use the SCRAPER_ prefix.

# --- service ---
# SQLite (default, file is created automatically) or Postgres:
#   DATABASE_URL=postgresql+asyncpg://scraper:scraper@localhost:5432/scraper
DATABASE_URL=sqlite+aiosqlite:///./data/scraper.db
SCRAPER_LOG_LEVEL=INFO
# Number of jobs processed concurrently by the in-process worker pool.
SCRAPER_WORKER_COUNT=2

# --- politeness ---
# Identify the bot honestly; robots.txt rules are matched against this.
# SCRAPER_USER_AGENT=SmartScraperBot/0.1.0 (+https://github.com/eshginfarzali/python-smart-scraper)
SCRAPER_MIN_HOST_DELAY_SECONDS=1.0
SCRAPER_MAX_HOST_CONCURRENCY=2
SCRAPER_MAX_CRAWL_DELAY_SECONDS=30
SCRAPER_ROBOTS_CACHE_TTL_SECONDS=3600
SCRAPER_ROBOTS_ERROR_TTL_SECONDS=300

# --- HTTP ---
SCRAPER_REQUEST_TIMEOUT_SECONDS=15
SCRAPER_CONNECT_TIMEOUT_SECONDS=5
SCRAPER_MAX_PAGE_BYTES=2097152
SCRAPER_MAX_REDIRECTS=5
SCRAPER_MAX_RETRIES=3
SCRAPER_BACKOFF_BASE_SECONDS=1.0
SCRAPER_BACKOFF_MAX_SECONDS=60
SCRAPER_MAX_RETRY_AFTER_SECONDS=120

# --- docker compose only ---
# HOST_PORT=8400
